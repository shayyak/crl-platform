<?xml version="1.0" encoding="UTF-8"?>
<!--
  Scheduled Task for the uploader. Import with:
    $xml = Get-Content -Raw D:\CrlPublisher\Publish-Crl.task.xml
    Register-ScheduledTask -TaskName 'Publish-Crl' -Xml $xml -User 'DOMAIN\gmsa-crlpub$'
  Triggers: (1) CRL published (Security event 4872, needs "Audit Certification Services" and the CA audit
  filter for revoke/publish events), delayed 30 s; (2) hourly safety run (retries, S3 repair, regular run_end).
  Replace DOMAIN\gmsa-crlpub$ and the paths. A gMSA needs "Log on as a batch job" on the CA.
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Publishes this CA's CRLs to the S3 storage of both sites (newpublish).</Description>
  </RegistrationInfo>
  <Triggers>
    <EventTrigger>
      <Enabled>true</Enabled>
      <Delay>PT30S</Delay>
      <Subscription>&lt;QueryList&gt;&lt;Query Id="0" Path="Security"&gt;&lt;Select Path="Security"&gt;*[System[(EventID=4872)]]&lt;/Select&gt;&lt;/Query&gt;&lt;/QueryList&gt;</Subscription>
    </EventTrigger>
    <TimeTrigger>
      <Enabled>true</Enabled>
      <StartBoundary>2026-01-01T00:07:00</StartBoundary>
      <Repetition>
        <Interval>PT1H</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
    </TimeTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>DOMAIN\gmsa-crlpub$</UserId>
      <LogonType>Password</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <ExecutionTimeLimit>PT10M</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "D:\CrlPublisher\Publish-Crl.ps1" -ConfigPath "D:\CrlPublisher\config.json"</Arguments>
      <WorkingDirectory>D:\CrlPublisher</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
